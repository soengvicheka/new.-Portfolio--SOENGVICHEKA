[TEMPLATE]
# ---------------------------------------------------------------------------
# Telegram contact form
# ---------------------------------------------------------------------------
# PRODUCTION (Vercel) - REQUIRED: add these two to Vercel -> Settings ->
# Environment Variables (WITHOUT the VITE_ prefix) and REDEPLOY. They are read
# server-side by api/send-telegram.js, so the bot token never ships to the
# browser:
#   TELEGRAM_BOT_TOKEN=123456:ABC...
#   TELEGRAM_CHAT_ID=123456789
#
# LOCAL DEV ONLY - Vite reads these from your local .env during `npm run dev`
# and talks to Telegram directly. Keep your REAL values here; never commit them
# (this file is committed to git, so keep the placeholders).
VITE_TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
VITE_TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID_HERE

# TELEGRAM_CHAT_ID / VITE_TELEGRAM_CHAT_ID must be YOUR personal chat ID (or a
# group ID where the bot is a member) - NOT the bot ID. A bot cannot message
# itself. Find your personal ID: message your bot, then ask @userinfobot
# or run: curl "https://api.telegram.org/bot<TOKEN>/getUpdates"


# ---------------------------------------------------------------------------
# Supabase (optional - enables publishing your CV + photo to ALL visitors)
# Create a free project at https://supabase.com, then copy your URL + anon key
# from Dashboard -> Settings -> API. Full instructions: CV_UPLOAD_SETUP.md
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
