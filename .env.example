[TEMPLATE]
# Telegram bot settings - copy your REAL values from your local .env file into
# your Vercel project (Settings -> Environment Variables) or the contact form
# will show "Telegram is not configured" on the deployed site.
# DO NOT commit real tokens here - this file is committed to git.
VITE_TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
VITE_TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID_HERE

# VITE_TELEGRAM_CHAT_ID must be YOUR personal chat ID (or a group ID where the
# bot is a member) - NOT the bot ID. A bot cannot message itself.
# Find your personal ID: message your bot, then ask @userinfobot
# or run: curl "https://api.telegram.org/bot<TOKEN>/getUpdates"


# ---------------------------------------------------------------------------
# Supabase (optional - enables publishing your CV + photo to ALL visitors)
# Create a free project at https://supabase.com, then copy your URL + anon key
# from Dashboard -> Settings -> API. Full instructions: CV_UPLOAD_SETUP.md
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
